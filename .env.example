# Copiar a .env.local (local) o cargar en Vercel > Settings > Environment Variables (produccion).
# Todas son solo de servidor: nunca les pongas el prefijo NEXT_PUBLIC_

# Mistral (console.mistral.ai > API Keys)
MISTRAL_API_KEY=
# opcional, por defecto mistral-medium-2604
MISTRAL_MODEL=

# Supabase (Project Settings > API Keys > Secret keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Riot API (developer.riotgames.com). La development key vence cada 24 h; para produccion, la personal key
RIOT_API_KEY=

# Secreto que manda el cron de Vercel en el header Authorization. Cualquier string largo al azar
CRON_SECRET=

# Contraseña para entrar a la app. En produccion es obligatoria: sin ella no entra nadie
APP_PASSWORD=
